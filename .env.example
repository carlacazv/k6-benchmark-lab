PERFORMANCE_PLAN=performance-test-plan.yaml
TELEMETRY_DISCOVERY_CONFIG=telemetry-discovery.yaml
TELEMETRY_CORRELATION_CONFIG=telemetry-correlation.yaml
EXPERIMENT_CONFIG=experiments/dependency-latency.yaml
OBSERVABILITY_CORRELATION_CONFIG=observability-correlation.yaml
PROMETHEUS_CONFIG=observability/prometheus.yml
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
TARGET_BASE_URL=http://127.0.0.1:3000
SCENARIO=smoke
# Preferred neutral names. *_RPS remain backward-compatible aliases.
BASELINE_RATE=5
PEAK_RATE=15
LIMIT_RATE=60
BASELINE_RPS=5
PEAK_RPS=15
LIMIT_RPS=60
PRE_ALLOCATED_VUS=20
MAX_VUS=100
NFR_P95_MS=500
NFR_P99_MS=1000
ERROR_RATE_THRESHOLD=0.01
CHECK_RATE_THRESHOLD=0.99
APDEX_T_MS=500
APDEX_MIN=0.85
APDEX_MIN_SAMPLES=20
WEB_LCP_MS=2500
WEB_INP_MS=200
WEB_CLS=0.1
WEB_TTFB_MS=800
K6_REPORT_DIR=artifacts/manual
PROMETHEUS_TOKEN=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
DD_API_KEY=
DD_APP_KEY=
LAB_BASE_LATENCY_MS=20
LAB_JITTER_MS=30
LAB_DEPENDENCY_LATENCY_MS=0
# When duration > 0, the dependency intervention becomes a workload-relative pulse.
LAB_DEPENDENCY_LATENCY_START_AFTER_MS=0
LAB_DEPENDENCY_LATENCY_DURATION_MS=0
LAB_DB_WAIT_MS=0
LAB_ERROR_RATE=0
LAB_CPU_BURN_MS=0
